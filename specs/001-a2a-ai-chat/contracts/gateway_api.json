{
  "openapi": "3.0.0",
  "info": {
    "title": "FastAPI Gateway API",
    "version": "1.0.0",
    "description": "Public facing Gateway API for the AI Chat Demo frontend. Frontend only interacts with this API."
  },
  "paths": {
    "/api/chat/stream": {
      "post": {
        "summary": "Stream Chat Completion",
        "description": "Submits a user message and returns a Server-Sent Events (SSE) stream from the Coordinator Agent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "The message prompt sent by the user."
                  },
                  "session_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Optional session ID to continue an existing chat thread."
                  }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stream of text chunks separated by SSE data blocks.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload or empty message query."
          }
        }
      }
    },
    "/api/sessions/{session_id}": {
      "get": {
        "summary": "Get Session History",
        "description": "Returns all prior messages associated with a session ID.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of messages in chronological order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": ["user", "assistant"]
                      },
                      "content": {
                        "type": "string"
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Session not found."
          }
        }
      }
    }
  }
}
